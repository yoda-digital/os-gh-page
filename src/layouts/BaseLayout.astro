---
import JsonLd from "~/components/JsonLd.astro";
import LangSwitcher from "~/components/LangSwitcher.astro";
import SeoHead from "~/components/SeoHead.astro";
import type { Locale } from "~/data/repos";
import { SITE_URL, htmlLang, localizedPath, t } from "~/i18n/ui";
import "~/styles/global.css";

interface Props {
  locale: Locale;
  pathname: string;
  title: string;
  description: string;
  ogImage?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  locale,
  pathname,
  title,
  description,
  ogImage,
  ogType = "website",
  jsonLd,
  noindex = false,
} = Astro.props;

const orgJsonLd = {
  "@type": "Organization",
  name: "Yoda Digital",
  url: "https://yoda.digital",
  sameAs: ["https://github.com/yoda-digital", "https://github.com/nalyk"],
};

const websiteJsonLd = {
  "@type": "WebSite",
  name: t(locale, "site.title"),
  url: SITE_URL,
  inLanguage: htmlLang(locale),
  potentialAction: {
    "@type": "SearchAction",
    target: `${SITE_URL}${localizedPath(locale, "/?q={search_term_string}")}`,
    "query-input": "required name=search_term_string",
  },
};

const ldArray: Record<string, unknown>[] = [orgJsonLd, websiteJsonLd];
if (jsonLd) {
  if (Array.isArray(jsonLd)) ldArray.push(...jsonLd);
  else ldArray.push(jsonLd);
}
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f8f6" media="(prefers-color-scheme: light)" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      locale={locale}
      pathname={pathname}
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
    <JsonLd data={ldArray} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <header class="border-b border-[var(--color-line)] bg-[var(--color-bg)]/90 backdrop-blur sticky top-0 z-10">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between gap-4">
        <a
          href={localizedPath(locale, "/")}
          class="flex items-center gap-3 font-mono font-semibold text-[var(--color-ink)] no-underline"
        >
          <img
            src="/brand/yoda_opensource_logo_white.svg"
            alt=""
            width="32"
            height="32"
            class="block w-8 h-8 shrink-0"
            loading="eager"
            decoding="async"
          />
          <span class="leading-none">
            <span class="text-[var(--color-accent)]">yoda</span>.digital
            <span class="text-[var(--color-muted)] ml-2 text-sm">/ open source</span>
          </span>
        </a>
        <nav class="hidden md:flex gap-6 text-sm">
          <a href={localizedPath(locale, "/projects/")}>{t(locale, "nav.projects")}</a>
          <a href={localizedPath(locale, "/mcp/")}>MCP</a>
          <a href={localizedPath(locale, "/cli/")}>CLI</a>
          <a href={localizedPath(locale, "/categories/")}>{t(locale, "nav.categories")}</a>
          <a href={localizedPath(locale, "/faq/")}>{t(locale, "nav.faq")}</a>
          <a href={localizedPath(locale, "/about/")}>{t(locale, "nav.about")}</a>
        </nav>
        <LangSwitcher locale={locale} pathname={pathname} />
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-[var(--color-line)] mt-16">
      <div class="max-w-6xl mx-auto px-4 py-8 text-sm text-[var(--color-muted)] flex flex-col md:flex-row gap-4 justify-between">
        <div>
          © {new Date().getFullYear()} Yoda Digital — MIT licensed unless noted otherwise.
        </div>
        <div class="flex gap-4">
          <a href="/llms.txt">llms.txt</a>
          <a href="/catalog.json">catalog.json</a>
          <a href="/mcp-catalog.json">mcp-catalog.json</a>
          <a href="https://github.com/yoda-digital">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
