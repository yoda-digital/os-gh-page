---
import Analytics from "~/components/Analytics.astro";
import ConsentBanner from "~/components/ConsentBanner.astro";
import JsonLd from "~/components/JsonLd.astro";
import LangSwitcher from "~/components/LangSwitcher.astro";
import SeoHead from "~/components/SeoHead.astro";
import type { Locale } from "~/data/repos";
import { SITE_URL, htmlLang, localizedPath, t } from "~/i18n/ui";
import "~/styles/global.css";

interface Props {
  locale: Locale;
  pathname: string;
  title: string;
  description: string;
  ogImage?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  locale,
  pathname,
  title,
  description,
  ogImage,
  ogType = "website",
  jsonLd,
  noindex = false,
} = Astro.props;

const orgJsonLd = {
  "@type": "Organization",
  name: "Yoda Digital",
  url: "https://yoda.digital",
  sameAs: ["https://github.com/yoda-digital", "https://github.com/nalyk"],
};

const websiteJsonLd = {
  "@type": "WebSite",
  name: t(locale, "site.title"),
  url: SITE_URL,
  inLanguage: htmlLang(locale),
  potentialAction: {
    "@type": "SearchAction",
    target: `${SITE_URL}${localizedPath(locale, "/?q={search_term_string}")}`,
    "query-input": "required name=search_term_string",
  },
};

const ldArray: Record<string, unknown>[] = [orgJsonLd, websiteJsonLd];
if (jsonLd) {
  if (Array.isArray(jsonLd)) ldArray.push(...jsonLd);
  else ldArray.push(jsonLd);
}
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <Analytics />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f8f6" media="(prefers-color-scheme: light)" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      locale={locale}
      pathname={pathname}
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
    <JsonLd data={ldArray} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <header class="border-b border-[var(--color-line)] bg-[var(--color-bg)]/90 backdrop-blur sticky top-0 z-10">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between gap-4">
        <a
          href={localizedPath(locale, "/")}
          class="flex items-center gap-3 font-mono font-semibold text-[var(--color-ink)] no-underline"
        >
          <img
            src="/brand/yoda_logo.png"
            alt=""
            width="35"
            height="32"
            class="block h-8 w-auto shrink-0"
            loading="eager"
            decoding="async"
          />
          <span class="leading-none">
            <span class="text-[var(--color-accent)]">yoda</span>.digital
            <span class="text-[var(--color-muted)] ml-2 text-sm">/ open source</span>
          </span>
        </a>
        <nav class="hidden md:flex gap-6 text-sm">
          <a href={localizedPath(locale, "/projects/")}>{t(locale, "nav.projects")}</a>
          <a href={localizedPath(locale, "/mcp/")}>MCP</a>
          <a href={localizedPath(locale, "/cli/")}>CLI</a>
          <a href={localizedPath(locale, "/categories/")}>{t(locale, "nav.categories")}</a>
          <a href={localizedPath(locale, "/faq/")}>{t(locale, "nav.faq")}</a>
          <a href={localizedPath(locale, "/about/")}>{t(locale, "nav.about")}</a>
        </nav>
        <LangSwitcher locale={locale} pathname={pathname} />
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-[var(--color-line)] mt-20 bg-[var(--color-surface)]/30">
      <div class="max-w-6xl mx-auto px-4 py-12 grid gap-10 md:grid-cols-4 text-sm">
        <div class="md:col-span-1">
          <div class="flex items-center gap-2 mb-3">
            <img
              src="/brand/yoda_logo.png"
              alt=""
              width="27"
              height="24"
              class="block h-6 w-auto"
              loading="lazy"
              decoding="async"
            />
            <span class="font-mono font-semibold text-[var(--color-ink)]">
              <span class="text-[var(--color-accent)]">yoda</span>.digital
            </span>
          </div>
          <p class="text-[var(--color-muted)] text-xs leading-relaxed">
            {t(locale, "site.tagline")}
          </p>
        </div>

        <nav class="md:col-span-1" aria-label={t(locale, "nav.projects")}>
          <h3 class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-accent)] mb-3">
            {t(locale, "nav.projects")}
          </h3>
          <ul class="space-y-2 text-[var(--color-muted)]">
            <li><a href={localizedPath(locale, "/projects/")} class="hover:text-[var(--color-ink)] no-underline">{t(locale, "section.allProjects")}</a></li>
            <li><a href={localizedPath(locale, "/categories/")} class="hover:text-[var(--color-ink)] no-underline">{t(locale, "nav.categories")}</a></li>
            <li><a href={localizedPath(locale, "/faq/")} class="hover:text-[var(--color-ink)] no-underline">{t(locale, "nav.faq")}</a></li>
            <li><a href={localizedPath(locale, "/about/")} class="hover:text-[var(--color-ink)] no-underline">{t(locale, "nav.about")}</a></li>
          </ul>
        </nav>

        <nav class="md:col-span-1" aria-label="Topic clusters">
          <h3 class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-accent)] mb-3">
            {locale === "ro" ? "Subiecte" : locale === "ru" ? "Темы" : "Topics"}
          </h3>
          <ul class="space-y-2 text-[var(--color-muted)]">
            <li><a href={localizedPath(locale, "/mcp/")} class="hover:text-[var(--color-ink)] no-underline">MCP servers</a></li>
            <li><a href={localizedPath(locale, "/cli/")} class="hover:text-[var(--color-ink)] no-underline">CLI</a></li>
            <li><a href={localizedPath(locale, "/contender/")} class="hover:text-[var(--color-ink)] no-underline">CONTender · ChatGPT App</a></li>
            <li><a href={localizedPath(locale, "/moldova-public-procurement-ai/")} class="hover:text-[var(--color-ink)] no-underline">Moldova procurement AI</a></li>
            <li><a href={localizedPath(locale, "/seo-automation-cli/")} class="hover:text-[var(--color-ink)] no-underline">SEO automation</a></li>
            <li><a href={localizedPath(locale, "/agent-infrastructure/")} class="hover:text-[var(--color-ink)] no-underline">Agent infrastructure</a></li>
          </ul>
        </nav>

        <nav class="md:col-span-1" aria-label="Machine-readable">
          <h3 class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-accent)] mb-3">
            {locale === "ro" ? "Pentru agenți" : locale === "ru" ? "Для агентов" : "For agents"}
          </h3>
          <ul class="space-y-2 text-[var(--color-muted)] font-mono text-xs">
            <li><a href="/llms.txt" class="hover:text-[var(--color-ink)] no-underline">/llms.txt</a></li>
            <li><a href="/llms-full.txt" class="hover:text-[var(--color-ink)] no-underline">/llms-full.txt</a></li>
            <li><a href="/catalog.json" class="hover:text-[var(--color-ink)] no-underline">/catalog.json</a></li>
            <li><a href="/mcp-catalog.json" class="hover:text-[var(--color-ink)] no-underline">/mcp-catalog.json</a></li>
            <li><a href={`/rss-${locale}.xml`} class="hover:text-[var(--color-ink)] no-underline">/rss-{locale}.xml</a></li>
            <li><a href="https://github.com/yoda-digital" class="hover:text-[var(--color-ink)] no-underline">GitHub →</a></li>
          </ul>
        </nav>
      </div>

      <div class="border-t border-[var(--color-line)]">
        <div class="max-w-6xl mx-auto px-4 py-4 text-xs text-[var(--color-muted)] flex flex-col md:flex-row gap-2 justify-between">
          <div>© {new Date().getFullYear()} Yoda Digital — MIT licensed unless noted otherwise.</div>
          <div class="font-mono flex items-center gap-3">
            <button
              type="button"
              data-open-consent
              class="underline decoration-dotted underline-offset-4 hover:text-[var(--color-ink)]"
            >
              {t(locale, "consent.banner.manage")}
            </button>
            <span>·</span>
            <span>
              {locale === "ro" ? "Construit de Ion Calmîș" : locale === "ru" ? "Сделано Ion Calmîș" : "Built by Ion Calmîș"} · opensource.yoda.digital
            </span>
          </div>
        </div>
      </div>
    </footer>
    <ConsentBanner locale={locale} />
    <script is:inline>
      document.addEventListener('click', function (e) {
        const t = e.target.closest('[data-open-consent]');
        if (t && typeof window.openConsentBanner === 'function') {
          e.preventDefault();
          window.openConsentBanner();
        }
      });
    </script>
  </body>
</html>
