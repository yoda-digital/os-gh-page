---
import { type Locale, allLocales } from "~/data/repos";
import { htmlLang, localizedPath, t } from "~/i18n/ui";

interface Props {
  locale: Locale;
  pathname: string;
}
const { locale, pathname } = Astro.props;
---

<nav aria-label="Language" class="flex items-center gap-2 text-sm">
  {
    allLocales.map((alt) => (
      <a
        href={localizedPath(alt, pathname)}
        hreflang={htmlLang(alt)}
        aria-current={alt === locale ? "true" : "false"}
        class:list={[
          "px-2 py-1 rounded transition-colors",
          alt === locale
            ? "text-[var(--color-accent)] font-semibold"
            : "text-[var(--color-muted)] hover:text-[var(--color-ink)]",
        ]}
      >
        {alt.toUpperCase()}
        <span class="sr-only"> — {t(locale, `lang.${alt}`)}</span>
      </a>
    ))
  }
</nav>
