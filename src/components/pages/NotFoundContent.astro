---
import type { Locale } from "~/data/repos";
import { localizedPath, t } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<BaseLayout
  locale={locale}
  pathname="/404/"
  title={t(locale, "page.404.title")}
  description={t(locale, "page.404.body")}
  noindex
>
  <section class="max-w-3xl mx-auto px-4 py-32 text-center">
    <p class="font-mono text-sm uppercase tracking-[0.3em] text-[var(--color-accent)] mb-4">404</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-6">{t(locale, "page.404.title")}</h1>
    <p class="text-[var(--color-muted)] max-w-xl mx-auto mb-10">{t(locale, "page.404.body")}</p>
    <a
      href={localizedPath(locale, "/")}
      class="inline-block px-5 py-3 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-surface)] hover:border-[var(--color-accent)] text-[var(--color-ink)] no-underline"
    >
      {t(locale, "page.404.cta")}
    </a>
  </section>
</BaseLayout>
