---
import ContenderServiceCard from "~/components/ContenderServiceCard.astro";
import ProjectCard from "~/components/ProjectCard.astro";
import { type Category, type Locale, reposByCategory } from "~/data/repos";
import { absoluteUrl, categoryLabels, t } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
  category: Category;
}
const { locale, category } = Astro.props;
const items = reposByCategory(category);
const label = categoryLabels[locale][category];
// CONTender is a hosted service (not a repo) but belongs to the Moldova
// public-procurement category — surface it as a featured card here too.
const showContender = category === "moldova-public-procurement";

const collection = {
  "@type": "CollectionPage",
  name: label,
  url: absoluteUrl(locale, `/categories/${category}/`),
  hasPart: [
    ...(showContender
      ? [
          {
            "@type": "SoftwareApplication",
            name: "CONTender",
            applicationCategory: "BusinessApplication",
            url: absoluteUrl(locale, "/contender/"),
          },
        ]
      : []),
    ...items.map((r) => ({
      "@type": "SoftwareApplication",
      name: r.slug,
      url: absoluteUrl(locale, `/projects/${r.slug}/`),
    })),
  ],
};

const breadcrumb = {
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t(locale, "site.title"),
      item: absoluteUrl(locale, "/"),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t(locale, "nav.categories"),
      item: absoluteUrl(locale, "/categories/"),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: label,
      item: absoluteUrl(locale, `/categories/${category}/`),
    },
  ],
};
---

<BaseLayout
  locale={locale}
  pathname={`/categories/${category}/`}
  title={`${label} — ${t(locale, "site.title")}`}
  description={`${label} — ${items.length} project${items.length === 1 ? "" : "s"}: ${items.map((r) => r.slug).join(", ")}.`}
  jsonLd={[breadcrumb, collection]}
>
  <section class="max-w-6xl mx-auto px-4 py-16">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-accent)] mb-3">
      {t(locale, "nav.categories")}
    </p>
    <h1 class="text-4xl md:text-5xl font-bold mb-3">{label}</h1>
    <p class="text-[var(--color-muted)] max-w-2xl mb-8">{t(locale, "page.category.intro")}</p>
    {
      showContender && (
        <div class="mb-8">
          <ContenderServiceCard locale={locale} />
        </div>
      )
    }
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {items.map((repo) => <ProjectCard locale={locale} repo={repo} />)}
    </div>
  </section>
</BaseLayout>
