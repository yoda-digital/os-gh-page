---
import RenderedMarkdown from "~/components/RenderedMarkdown.astro";
import RepoMetrics from "~/components/RepoMetrics.astro";
import type { Locale, RepoEntry } from "~/data/repos";
import { githubFor, readmeFor } from "~/generated";
import { absoluteUrl, categoryLabels, t } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
  repo: RepoEntry;
}
const { locale, repo } = Astro.props;

const gh = githubFor(repo.slug);
const readme = readmeFor(repo.slug);
const branch = gh?.defaultBranch ?? "main";
const ghBlob = `https://github.com/${repo.owner}/${repo.repo}/blob/${branch}/README.md`;
const ghEdit = `https://github.com/${repo.owner}/${repo.repo}/edit/${branch}/README.md`;

const docsTitle: Record<Locale, string> = {
  ro: "Documentație",
  en: "Documentation",
  ru: "Документация",
};
const sourceNote: Record<Locale, string> = {
  ro: "Conținut original în engleză, sincronizat din depozit la fiecare build.",
  en: "Original English content, synced from the repository on every build.",
  ru: "Оригинальный английский контент, синхронизируется из репозитория на каждой сборке.",
};
const onGithubLabel: Record<Locale, string> = {
  ro: "Vezi originalul pe GitHub",
  en: "View original on GitHub",
  ru: "Открыть оригинал на GitHub",
};
const editLabel: Record<Locale, string> = {
  ro: "Propune o modificare",
  en: "Suggest an edit",
  ru: "Предложить правку",
};
const missingLabel: Record<Locale, string> = {
  ro: "README-ul nu a fost încărcat la ultimul build. Verifică pe GitHub.",
  en: "README was not fetched at the last build. Check the source on GitHub.",
  ru: "README не был загружен при последней сборке. Проверьте исходник на GitHub.",
};

const breadcrumb = {
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t(locale, "site.title"),
      item: absoluteUrl(locale, "/"),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: repo.slug,
      item: absoluteUrl(locale, `/projects/${repo.slug}/`),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: docsTitle[locale],
      item: absoluteUrl(locale, `/docs/${repo.slug}/readme/`),
    },
  ],
};

const techArticle = {
  "@type": "TechArticle",
  headline: `${repo.slug} — README`,
  inLanguage: "en-US",
  url: absoluteUrl(locale, `/docs/${repo.slug}/readme/`),
  about: {
    "@type": "SoftwareSourceCode",
    name: repo.slug,
    codeRepository: `https://github.com/${repo.owner}/${repo.repo}`,
  },
  ...(gh?.latestCommit && { dateModified: gh.latestCommit.date }),
  publisher: { "@type": "Organization", name: "Yoda Digital", url: "https://yoda.digital" },
};

// Canonical points to the GitHub README — the upstream is authoritative.
// Pages remain crawlable but won't compete with GitHub for the same query.
---

<BaseLayout
  locale={locale}
  pathname={`/docs/${repo.slug}/readme/`}
  title={`${repo.slug} — ${docsTitle[locale]}`}
  description={`${repo.positioning[locale].productAngle} — README.`}
  ogType="article"
  jsonLd={[breadcrumb, techArticle]}
>
  <article class="max-w-5xl mx-auto px-4 py-12">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-accent)] mb-3">
      {categoryLabels[locale][repo.category]} · {docsTitle[locale]}
    </p>
    <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-3">{repo.slug}</h1>
    <p class="text-[var(--color-muted)] text-sm mb-8">{sourceNote[locale]}</p>

    <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-surface)] p-5 mb-8">
      <RepoMetrics locale={locale} repo={repo} variant="page" />
    </div>

    <div class="flex flex-wrap gap-3 mb-10">
      <a
        href={absoluteUrl(locale, `/projects/${repo.slug}/`)}
        class="px-4 py-2 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-surface)] hover:border-[var(--color-accent)] no-underline text-[var(--color-ink)] text-sm"
      >
        ← {repo.slug}
      </a>
      <a
        href={absoluteUrl(locale, `/install/${repo.slug}/`)}
        class="px-4 py-2 rounded-[var(--radius-card)] border border-[var(--color-accent)] bg-[var(--color-accent)]/10 hover:bg-[var(--color-accent)]/20 no-underline text-[var(--color-accent)] text-sm font-semibold"
      >
        {t(locale, "cta.install")} →
      </a>
      <a
        href={ghBlob}
        rel="noopener"
        class="px-4 py-2 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-surface)] hover:border-[var(--color-accent)] no-underline text-[var(--color-ink)] text-sm"
      >
        {onGithubLabel[locale]}
      </a>
      <a
        href={ghEdit}
        rel="noopener"
        class="px-4 py-2 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-surface)] hover:border-[var(--color-accent)] no-underline text-[var(--color-muted)] text-sm"
      >
        {editLabel[locale]}
      </a>
    </div>

    {
      readme ? (
        <RenderedMarkdown
          source={readme}
          repo={`${repo.owner}/${repo.repo}`}
          branch={branch}
        />
      ) : (
        <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-surface)] p-8 text-center text-[var(--color-muted)]">
          {missingLabel[locale]}
        </div>
      )
    }
  </article>
</BaseLayout>
