---
import ProjectCard from "~/components/ProjectCard.astro";
import { type Locale, repos } from "~/data/repos";
import { absoluteUrl, t } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const sortedRepos = [...repos].sort((a, b) => b.priority - a.priority);

const collection = {
  "@type": "CollectionPage",
  name: t(locale, "section.allProjects"),
  url: absoluteUrl(locale, "/projects/"),
  hasPart: sortedRepos.map((r) => ({
    "@type": "SoftwareApplication",
    name: r.slug,
    url: absoluteUrl(locale, `/projects/${r.slug}/`),
  })),
};

const breadcrumb = {
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t(locale, "site.title"),
      item: absoluteUrl(locale, "/"),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t(locale, "nav.projects"),
      item: absoluteUrl(locale, "/projects/"),
    },
  ],
};
---

<BaseLayout
  locale={locale}
  pathname="/projects/"
  title={t(locale, "section.allProjects")}
  description={t(locale, "site.description")}
  jsonLd={[collection, breadcrumb]}
>
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h1 class="text-3xl md:text-4xl font-bold mb-3">{t(locale, "section.allProjects")}</h1>
    <p class="text-[var(--color-muted)] max-w-2xl mb-10">{t(locale, "site.description")}</p>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {sortedRepos.map((repo) => <ProjectCard locale={locale} repo={repo} />)}
    </div>
  </section>
</BaseLayout>
