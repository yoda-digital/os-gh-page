---
import HeroConstellation from "~/components/HeroConstellation.astro";
import ProjectCard from "~/components/ProjectCard.astro";
import { type Locale, repos } from "~/data/repos";
import { t } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const sortedRepos = [...repos].sort((a, b) => b.priority - a.priority);
const installRotation = [
  "npx -y mcp-ansc-server",
  "npm i -g @nalyk/gsccli",
  "npx -y mtender-mcp-server",
  "npx -y @yoda.digital/gitlab-mcp-server",
];
---

<BaseLayout
  locale={locale}
  pathname="/"
  title={t(locale, "site.title")}
  description={t(locale, "site.description")}
>
  <section class="border-b border-[var(--color-line)]">
    <div class="max-w-6xl mx-auto px-4 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-accent)] mb-4">
        {t(locale, "section.heroEyebrow")}
      </p>
      <h1 class="text-4xl md:text-6xl font-bold leading-[1.05] mb-6 max-w-3xl">
        {t(locale, "site.tagline")}
      </h1>
      <p class="text-lg md:text-xl text-[var(--color-muted)] max-w-2xl leading-relaxed">
        {t(locale, "site.description")}
      </p>
      <div class="mt-8 flex flex-wrap gap-3 font-mono text-sm">
        {
          installRotation.map((cmd) => (
            <code class="px-3 py-2 rounded bg-[var(--color-surface)] border border-[var(--color-line)]">
              {cmd}
            </code>
          ))
        }
      </div>
      <HeroConstellation locale={locale} />
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-semibold mb-8 text-[var(--color-ink)]">
      {t(locale, "section.allProjects")}
    </h2>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {sortedRepos.map((repo) => <ProjectCard locale={locale} repo={repo} />)}
    </div>
  </section>
</BaseLayout>
