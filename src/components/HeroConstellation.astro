---
/**
 * Static SVG hero constellation. Six nodes pinned around four category orbits.
 * Crawler-friendly: each node is a real <a> link to /projects/<slug>/.
 * Layout is deterministic from the manifest — adding a project = re-deriving
 * angle by category-position then priority.
 */
import { type Category, type Locale, repos } from "~/data/repos";
import { categoryLabels, htmlLang, localizedPath } from "~/i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const categoryOrder: Category[] = [
  "ai-devtools-mcp",
  "moldova-public-procurement",
  "seo-analytics",
  "agent-infrastructure",
];

const labelLines: Record<Category, string> = {
  "ai-devtools-mcp": "AI / MCP",
  "moldova-public-procurement":
    locale === "ro" ? "Achiziții MD" : locale === "ru" ? "Закупки MD" : "Procurement",
  "seo-analytics": "SEO / GA4",
  "agent-infrastructure": locale === "ro" ? "Agenți" : locale === "ru" ? "Агенты" : "Agents",
};

interface Pos {
  x: number;
  y: number;
  slug: string;
  category: Category;
}

// Polar layout: each category gets a 90° quadrant; projects in the same
// category share the quadrant, sorted by priority.
const W = 720;
const H = 360;
const cx = W / 2;
const cy = H / 2;
const r = 130;

const positions: Pos[] = [];
for (let i = 0; i < categoryOrder.length; i++) {
  const cat = categoryOrder[i];
  const inCat = repos.filter((r) => r.category === cat).sort((a, b) => b.priority - a.priority);
  const baseAngle = (Math.PI / 2) * i - Math.PI / 4;
  for (let j = 0; j < inCat.length; j++) {
    const offset = (j - (inCat.length - 1) / 2) * 0.18;
    const angle = baseAngle + offset;
    positions.push({
      x: cx + r * Math.cos(angle),
      y: cy + r * Math.sin(angle),
      slug: inCat[j].slug,
      category: cat,
    });
  }
}

const langCode = htmlLang(locale);
---

<figure class="my-8" aria-label="Yoda Digital open-source ecosystem map">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    lang={langCode}
    class="w-full h-auto max-h-[360px]"
  >
    <title>Yoda Digital — open source ecosystem ({langCode})</title>
    <defs>
      <radialGradient id="hero-halo" cx="0.5" cy="0.5" r="0.6">
        <stop offset="0" stop-color="#af9568" stop-opacity="0.15"/>
        <stop offset="1" stop-color="#af9568" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <rect x="0" y="0" width={W} height={H} fill="url(#hero-halo)"/>

    <g stroke="#1f2530" stroke-width="1" fill="none" opacity="0.55">
      <circle cx={cx} cy={cy} r={60}/>
      <circle cx={cx} cy={cy} r={r}/>
      <circle cx={cx} cy={cy} r={r + 60}/>
    </g>

    <g stroke="#1f2530" stroke-width="0.7" fill="none" opacity="0.4">
      {positions.map((p) => (
        <line x1={cx} y1={cy} x2={p.x} y2={p.y} />
      ))}
    </g>

    <g font-family="ui-monospace, SFMono-Regular, Menlo, monospace" fill="#8d93a3" font-size="11" text-anchor="middle">
      {categoryOrder.map((cat, i) => {
        const angle = (Math.PI / 2) * i - Math.PI / 4;
        const lx = cx + (r + 36) * Math.cos(angle);
        const ly = cy + (r + 36) * Math.sin(angle) + 4;
        return <text x={lx} y={ly}>{labelLines[cat]}</text>;
      })}
    </g>

    <g font-family="ui-mono, SFMono-Regular, Menlo, monospace" fill="#e8eaef" font-size="13" text-anchor="middle" font-weight="600">
      <text x={cx} y={cy - 4}>yoda.digital</text>
      <text x={cx} y={cy + 14} fill="#8d93a3" font-size="10">/ open source</text>
    </g>

    <g>
      {positions.map((p) => (
        <a href={localizedPath(locale, `/projects/${p.slug}/`)} aria-label={p.slug}>
          <circle cx={p.x} cy={p.y} r={9} fill="#0b0d12" stroke="#af9568" stroke-width="2"/>
          <circle cx={p.x} cy={p.y} r={4} fill="#af9568"/>
          <text
            x={p.x}
            y={p.y + 24}
            font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
            font-size="11"
            text-anchor="middle"
            fill="#e8eaef"
          >{p.slug}</text>
        </a>
      ))}
    </g>
  </svg>
  <figcaption class="sr-only">
    {categoryOrder.map((c) => `${categoryLabels[locale][c]}: ${repos.filter((r) => r.category === c).map((r) => r.slug).join(", ")}`).join(". ")}
  </figcaption>
</figure>
