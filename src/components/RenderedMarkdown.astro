---
/**
 * Wraps the markdown renderer in a styled container that matches the
 * portal's dark surface. Owns the prose styling so individual pages
 * don't have to.
 */
import { renderMarkdown } from "~/lib/markdown";

interface Props {
  source: string;
  repo: string;
  branch: string;
}
const { source, repo, branch } = Astro.props;
const html = await renderMarkdown(source, { repo, branch });
---

<div class="rendered-markdown" set:html={html} />

<style is:global>
  .rendered-markdown {
    color: var(--color-ink);
    line-height: 1.7;
    font-size: 1rem;
  }
  .rendered-markdown > :first-child {
    margin-top: 0;
  }
  .rendered-markdown h1,
  .rendered-markdown h2,
  .rendered-markdown h3,
  .rendered-markdown h4,
  .rendered-markdown h5,
  .rendered-markdown h6 {
    font-weight: 700;
    line-height: 1.25;
    margin-top: 2em;
    margin-bottom: 0.6em;
    color: var(--color-ink);
    scroll-margin-top: 5rem;
  }
  .rendered-markdown h1 { font-size: 2rem; }
  .rendered-markdown h2 {
    font-size: 1.5rem;
    padding-bottom: 0.3em;
    border-bottom: 1px solid var(--color-line);
  }
  .rendered-markdown h3 { font-size: 1.25rem; }
  .rendered-markdown h4 { font-size: 1.05rem; }
  .rendered-markdown p {
    margin: 1em 0;
    color: var(--color-ink);
  }
  .rendered-markdown a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--color-accent) 40%, transparent);
    text-underline-offset: 3px;
  }
  .rendered-markdown a:hover {
    text-decoration-color: var(--color-accent);
  }
  .rendered-markdown ul,
  .rendered-markdown ol {
    margin: 1em 0;
    padding-left: 1.5em;
  }
  .rendered-markdown ul { list-style: disc; }
  .rendered-markdown ol { list-style: decimal; }
  .rendered-markdown li { margin: 0.4em 0; }
  .rendered-markdown li > p { margin: 0.3em 0; }
  .rendered-markdown blockquote {
    margin: 1.5em 0;
    padding: 0.5em 1em;
    border-left: 3px solid var(--color-accent);
    background: var(--color-surface);
    color: var(--color-muted);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
  }
  .rendered-markdown code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.3em;
    color: var(--color-accent);
  }
  .rendered-markdown pre {
    background: #0a0c10;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 1em 1.2em;
    overflow-x: auto;
    margin: 1.5em 0;
    font-size: 0.85em;
    line-height: 1.55;
  }
  .rendered-markdown pre code {
    background: transparent;
    border: 0;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }
  .rendered-markdown table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
    font-size: 0.92em;
  }
  .rendered-markdown table thead {
    background: var(--color-surface);
  }
  .rendered-markdown table th,
  .rendered-markdown table td {
    border: 1px solid var(--color-line);
    padding: 0.6em 0.8em;
    text-align: left;
    vertical-align: top;
  }
  .rendered-markdown table th {
    color: var(--color-ink);
    font-weight: 600;
  }
  .rendered-markdown table td {
    color: var(--color-muted);
  }
  .rendered-markdown img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    margin: 1em 0;
  }
  .rendered-markdown hr {
    border: 0;
    border-top: 1px solid var(--color-line);
    margin: 2em 0;
  }
  .rendered-markdown :where(h1, h2, h3, h4) > code {
    font-size: 0.9em;
  }
</style>
