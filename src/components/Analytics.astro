---
// Google Analytics 4 (gtag.js) with Google Consent Mode v2.
//
// Compliance posture: default-deny for analytics_storage, ad_storage,
// ad_user_data, ad_personalization. No identifiers are set until the
// visitor accepts via <ConsentBanner />. wait_for_update: 500 holds the
// first hit briefly so an immediate Accept click can upgrade it from a
// cookieless ping to a full event without losing it.
//
// Production-only: the entire block is statically false in `astro dev`,
// so local browsing never hits the property. Override PUBLIC_GA_ID in
// the Cloudflare Pages environment to point a fork or preview deploy at
// a different property without touching code.
const GA_ID = import.meta.env.PUBLIC_GA_ID ?? "G-88WRY15JN3";
const enabled = import.meta.env.PROD && Boolean(GA_ID);
---
{
  enabled && (
    <>
      <script is:inline define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        window.gtag = gtag;

        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 500,
        });

        gtag('js', new Date());
        gtag('config', GA_ID);

        try {
          const raw = localStorage.getItem('ga_consent_v2');
          if (raw) {
            const saved = JSON.parse(raw);
            const fresh = Date.now() - (saved.ts || 0) < 180 * 86400 * 1000;
            if (fresh && saved.state === 'granted') {
              gtag('consent', 'update', {
                ad_storage: 'granted',
                ad_user_data: 'granted',
                ad_personalization: 'granted',
                analytics_storage: 'granted',
              });
            }
          }
        } catch (_) {}
      </script>
      <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
    </>
  )
}
