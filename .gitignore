# Build output
dist/
.astro/

# Generated data (rebuilt every build by src/scripts/run-prebuild.ts)
src/generated/*
!src/generated/index.ts
!src/generated/.gitkeep
public/catalog.json
public/mcp-catalog.json
public/llms.txt
public/llms-full.txt
# Per-page OG SVGs are generated by src/scripts/generate-og.ts;
# only the static fallback default.svg is tracked.
public/og/*.svg
!public/og/default.svg
public/og/projects/
public/og/pillars/
public/og/categories/

# Dependencies
node_modules/
.pnp
.pnp.js

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Env
.env
.env.*
!.env.example

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Cloudflare
.wrangler/

# Coverage
coverage/

